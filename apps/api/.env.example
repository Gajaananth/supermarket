NODE_ENV=development
APP_ENV=development
HOST=127.0.0.1
PORT=4000
# Comma-separated browser origins. Production must list the actual HTTPS origins.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Use PostgreSQL; replace the credentials and database as needed.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5433/buyme?schema=public
ORDER_ACCEPT_TIMEOUT_SECONDS=300
ORDER_TIMEOUT_SWEEP_CRON=* * * * *
# Optional override; by default pg-boss uses "pgboss" in production and the
# disposable Prisma schema during isolated tests.
PG_BOSS_SCHEMA=
STORAGE_LOCAL_DIR=E:/buyme-tools/storage

# Private S3-compatible storage for rider KYC images and bank-deposit slips.
# For MinIO, set the endpoint, bucket, region, credentials, and path-style flag.
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_FORCE_PATH_STYLE=false
OBJECT_STORAGE_PRESIGN_TTL_SECONDS=600

# ClamAV daemon; KYC submission fails closed when the scanner cannot be reached.
CLAMAV_HOST=
CLAMAV_PORT=3310

# Generate two different random secrets with at least 32 characters each.
JWT_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=30

# Twilio SMS: set all three values when SMS_PROVIDER=twilio.
SMS_PROVIDER=none
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Resend email notifications; configure a verified sender when enabling this provider.
EMAIL_PROVIDER=none
RESEND_API_KEY=
EMAIL_FROM=

# OneSignal push notifications. The app must identify the signed-in user using
# their BuyMe user UUID as the OneSignal external ID.
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=

# Firebase Admin service-account JSON for FCM push notifications.
# Keep the real credential only in a local environment/secret manager.
FIREBASE_SERVICE_ACCOUNT_JSON=

# OSM Nominatim and OSRM public endpoints; replace with managed services when
# production traffic exceeds their public-use policies.
OSM_CONTACT_EMAIL=
OSM_NOMINATIM_URL=https://nominatim.openstreetmap.org
OSM_ROUTING_URL=https://router.project-osrm.org
OSM_MIN_INTERVAL_MS=1000
MAP_CACHE_TTL_SECONDS=3600
MAP_CACHE_MAX_ENTRIES=1000
SOCKET_EVENT_LIMIT=60
SOCKET_EVENT_WINDOW_SECONDS=60

# Required only when running the seed against an empty database.
SEED_SUPER_ADMIN_PASSWORD=
SEED_STORE_ADMIN_PASSWORD=
ALLOW_DEMO_SEED=false

# Enable only for local development; OTP codes are then logged and returned for testing.
OTP_DEV_MODE=false
# Staging only: mock OTP for explicitly seeded demo accounts. Supply the code
# through the staging secret manager; never commit its value.
DEMO_OTP_ENABLED=false
DEMO_OTP_CODE=
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=3

THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100
