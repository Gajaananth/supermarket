{
  "name": "buyme-api",
  "version": "1.0.0",
  "private": true,
  "description": "BuyMe Hyperlocal Grocery Delivery Backend API (NestJS / Prisma / PostgreSQL)",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc",
    "start": "node dist/main.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:seed": "tsx prisma/seed.ts",
    "test": "npm run build && vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && vitest run --config vitest.config.ts",
    "test:stock:e2e": "npm run build && tsx test/run-stock-e2e.ts",
    "test:orders:e2e": "npm run build && tsx test/run-orders-e2e.ts",
    "test:cash-control:e2e": "npm run build && tsx test/run-cash-control-e2e.ts",
    "test:rider-onboarding:e2e": "npm run build && tsx test/run-rider-onboarding-e2e.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1169.0",
    "@aws-sdk/s3-request-presigner": "^3.1169.0",
    "@buyme/api-contract": "file:../../packages/api-contract",
    "@nestjs/common": "^12.5.1",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.5.1",
    "@nestjs/jwt": "^12.0.5",
    "@nestjs/passport": "^12.0.2",
    "@nestjs/platform-express": "^12.5.1",
    "@nestjs/platform-socket.io": "^12.5.1",
    "@nestjs/swagger": "^12.1.2",
    "@nestjs/throttler": "^6.8.0",
    "@nestjs/websockets": "^12.5.1",
    "@prisma/client": "^5.22.0",
    "argon2": "^0.40.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.5",
    "firebase-admin": "^14.5.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg-boss": "^12.38.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.4",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.5.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.20.5",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.2",
    "prisma": "^5.22.0",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.0.0",
    "tsx": "^4.19.1",
    "typescript": "^5.5.4",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
