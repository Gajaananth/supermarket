            }
          }
        },
        "responses": {
          "200": {
            "description": "Admin authenticated or 2FA required"
          },
          "401": {
            "description": "Invalid email or password"
          }
        },
        "tags": [
          "Authentication & Identity"
        ]
      }
    },
    "/api/v1/auth/admin/verify-2fa": {
      "post": {
        "operationId": "AuthController_verifyAdmin2fa",
