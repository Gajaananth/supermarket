  "info": {
    "title": "BuyMe Hyperlocal Delivery Platform API",
    "description": "OpenAPI contract generated from the NestJS application",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "JWT-auth": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "RequestCustomerOtpDto": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string",
            "example": "+94772220001",
            "description": "Customer Sri Lankan mobile number in E.164 format"
          }
        },
        "required": [
          "phone"
        ]
      },
      "VerifyCustomerOtpDto": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string",
            "example": "+94772220001"
          },
          "code": {
            "type": "string",
            "example": "123456",
            "description": "6-digit numeric OTP"
          },
          "deviceId": {
            "type": "string",
            "example": "device-uuid-1234",
            "default": "browser-client"
          },
