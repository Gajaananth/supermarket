        "responses": {
          "200": {
            "description": "Tokens rotated successfully"
          },
          "401": {
            "description": "Token compromised or expired"
          }
        },
        "tags": [
          "Authentication & Identity"
        ]
      }
    },
    "/api/v1/auth/logout": {
      "post": {
