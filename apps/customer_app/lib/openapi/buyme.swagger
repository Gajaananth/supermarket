        },
        "responses": {
          "200": {
            "description": "Super Admin authenticated"
          },
          "400": {
            "description": "Invalid 2FA code"
          }
        },
        "tags": [
          "Authentication & Identity"
        ]
      }
    },
    "/api/v1/auth/refresh": {
      "post": {
        "operationId": "AuthController_refresh",
