{
  "openapi": "3.0.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "HealthController_check",
        "summary": "System Health & DB Connectivity Ping",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Health check successful"
          },
          "503": {
            "description": "Database connectivity check failed"
          }
        },
        "tags": [
          "System & Health"
        ]
      }
    },
    "/api/v1/auth/customer/otp-request": {
      "post": {
        "operationId": "AuthController_requestCustomerOtp",
        "summary": "Request Customer OTP login code (Phone only)",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RequestCustomerOtpDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OTP dispatched via SMS provider"
          },
          "429": {
            "description": "Rate limit exceeded (max 3 per 5 mins)"
          }
        },
        "tags": [
          "Authentication & Identity"
        ]
      }
    },
    "/api/v1/auth/customer/otp-verify": {
      "post": {
        "operationId": "AuthController_verifyCustomerOtp",
        "summary": "Verify Customer OTP & issue access + rotating refresh tokens",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerifyCustomerOtpDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authentication successful"
          },
          "400": {
            "description": "Invalid or expired OTP"
          }
        },
        "tags": [
          "Authentication & Identity"
        ]
      }
    },
    "/api/v1/auth/rider/otp-request": {
      "post": {
        "operationId": "AuthController_requestRiderOtp",
        "summary": "Request Rider OTP login code (Phone or Email)",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RequestRiderOtpDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Rider OTP dispatched"
          },
          "429": {
            "description": "Rate limit exceeded"
          }
        },
        "tags": [
          "Authentication & Identity"
        ]
      }
    },
    "/api/v1/auth/rider/otp-verify": {
      "post": {
        "operationId": "AuthController_verifyRiderOtp",
        "summary": "Verify Rider OTP & authenticate",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerifyRiderOtpDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Rider authenticated"
          }
        },
        "tags": [
          "Authentication & Identity"
        ]
      }
    },
    "/api/v1/auth/rider/registration/otp-request": {
      "post": {
        "operationId": "AuthController_requestRiderRegistrationOtp",
        "summary": "Request an OTP to register a rider account",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RequestRiderRegistrationOtpDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Registration OTP sent to the rider phone"
          },
          "429": {
            "description": "Per-phone or per-IP OTP rate limit exceeded"
          }
        },
        "tags": [
          "Authentication & Identity"
        ]
      }
    },
    "/api/v1/auth/rider/registration/otp-verify": {
      "post": {
        "operationId": "AuthController_verifyRiderRegistrationOtp",
        "summary": "Verify registration OTP and create a pending rider account",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerifyRiderRegistrationOtpDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Rider account created in REGISTERED state"
          },
          "400": {
            "description": "Invalid OTP or phone/email already registered"
          }
        },
        "tags": [
          "Authentication & Identity"
        ]
      }
    },
    "/api/v1/auth/admin/login": {
      "post": {
        "operationId": "AuthController_adminLogin",
        "summary": "Admin login by Email + Argon2 Password (Optional 2FA for Super Admin)",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AdminLoginDto"
